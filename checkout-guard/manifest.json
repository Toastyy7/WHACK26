{
  "manifest_version": 3,
  "name": "CheckoutGuard - Spending & Impulse Shield",
  "version": "1.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "checkout-guard@whack26.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "Protects against impulse overspending with automated checkout detection, budget impact preview, and reflection cooldowns.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CheckoutGuard Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "core.js",
        "detect.js",
        "sync.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
